# Copy to .env (git-ignored) and replace every value before using outside of local development.
# docker compose reads .env automatically. Values with special characters must not contain '$' or '@'/':'
# in the passwords that end up in a connection string (Mongo, Postgres).

# --- JWT (gateway and auth). Generate: openssl rand -base64 48 ---
JWT_KEY=

# --- First administrator, created by auth.api on start if missing ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=

# --- PostgreSQL. Changing a password does not change an already initialised database volume ---
CORE_DB_PASSWORD=
AUTH_DB_PASSWORD=

# --- MongoDB ---
MONGO_USER=admin
MONGO_PASSWORD=

# --- LLM provider (Groq, OpenRouter, ... any OpenAI-compatible API) ---
LLM_API_KEY=

# --- SMTP for e-mails (optional) ---
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# --- S3 storage for uploaded files (optional) ---
S3_SERVICE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
