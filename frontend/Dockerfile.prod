# Production image: the site is built once and served by nginx. The API address is fixed at build time.
FROM node:lts-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .

# Address of the API as the browser sees it, e.g. https://example.org/practices-service/api
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN test -n "$VITE_API_BASE_URL" && npx vite build

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
# The site lives under /practices-service/ (the base of Vite and of the router).
COPY --from=build /app/dist /usr/share/nginx/html/practices-service
EXPOSE 80
