{
    "RabbitMQ": {
        "Host": "rabbitmq",
        "Port": 5672
    },
    "Jwt": {
        "Issuer": "AuthService",
        "Audience": "Gateway",
        "ExpireMinutes": "15"
    },
    "Frontend": {
        "Url": "http://localhost:8000/practices-service"
    },
    "ConnectionStrings": {
        "Default": "Host=localhost:1435;Database=postgres;Username=postgres"
    },
    "Swagger": {
        "GatewayBasePath": "/auth-swagger"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
